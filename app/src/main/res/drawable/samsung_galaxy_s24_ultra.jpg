background-color: rgb(27, 26, 25); }

.actionmenularge .actionmenucontent .actionlist .actionitem.shareactionitem=
 .share-preview-content { height: 165px; overflow: auto; user-select: none;=
 scrollbar-width: thin; }

.actionmenularge .actionmenucontent .actionlist .actionitem.shareactionitem=
 .share-preview-content cib-history-conversation { display: flex; min-heigh=
t: 100%; }

.actionmenularge .actionmenucontent .actionlist .actionitem.shareactionitem=
 .sharemedia { display: grid; position: relative; justify-content: space-be=
tween; grid-template-columns: repeat(auto-fill, 96px); margin-top: 6px; mar=
gin-bottom: 0px; padding: 6px 0px 0px; }

.actionmenumobile.actionmenularge .actionmenucontent .actionlist .actionite=
m.shareactionitem .sharemedia { display: block; max-width: 90vw; overflow-x=
: auto; }

.actionmenularge .actionmenucontent .actionlist .actionitem.shareactionitem=
 .sharemedia .sharemedia_item { height: 122px; margin: 0px; position: relat=
ive; }

.actionmenularge .actionmenucontent .actionlist .actionitem.shareactionitem=
 .sharemedia a { padding: 12px 24px 70px; border-radius: 4px; margin: 0px; =
}

.actionmenumobile.actionmenularge .actionmenucontent .actionlist .actionite=
m.shareactionitem .sharemedia a { padding: 12px 18px 42px; }

.actionmenudark.actionmenularge .actionmenucontent .actionlist .actionitem.=
shareactionitem .sharemedia a:hover, .actionmenudark.actionmenularge .actio=
nmenucontent .actionlist .actionitem.shareactionitem .sharemedia a:focus { =
background-color: rgb(59, 58, 57); }

.actionmenularge .actionmenucontent .actionlist .actionitem.shareactionitem=
 .sharemedia a .actIconSvg svg.b_hide { display: none; }

.actionmenularge .actionmenucontent .actionlist .actionitem.shareactionitem=
 .sharemedia a .actIconSvg svg { height: 48px; width: 48px; transform: scal=
e(0.8333); border-radius: 50%; fill: none !important; }

.actionmenularge .actionmenucontent .actionlist .actionitem.shareactionitem=
 .sharemedia a .actIconImg { transform: scale(0.8333); }

.actionmenularge .actionmenucontent .actionlist .actionitem.shareactionitem=
 .sharemedia .shareMediumText { text-align: center; line-height: 1; white-s=
pace: normal; top: 72px; left: 0px; right: 0px; position: absolute; color: =
rgb(68, 68, 68); }

.actionmenularge .actionmenucontent .actionlist .actionitemdivider { displa=
y: none; }

@media screen and (forced-colors: active) and (prefers-color-scheme: dark) =
{
  .actionitem.shareactionitem svg { fill: rgb(255, 255, 255) !important; }
}

.actionmenularge .actionmenucontent.screenshot .sreenshot-container { posit=
ion: relative; height: 200px; border-radius: 6px; border: 1px solid rgb(238=
, 238, 238); margin-top: 12px; }

.actionmenularge .actionmenucontent.screenshot .sreenshot-container.loading=
 .image-container { animation: 3s linear 0s infinite normal none running br=
eathe; }

.actionmenularge .actionmenucontent.screenshot .sreenshot-container .image-=
container { position: relative; overflow: hidden; height: 100%; width: 100%=
; border-radius: 6px; background: rgb(255, 255, 255); display: flex; justif=
y-content: center; align-items: center; }

.actionmenularge .actionmenucontent.screenshot .sreenshot-container .image-=
container img { max-width: 100%; max-height: 100%; z-index: 1; }

.actionmenularge .actionmenucontent.screenshot .sreenshot-container .backgr=
ound-image { position: absolute; inset: 0px; background-repeat: no-repeat; =
background-size: cover; filter: blur(37.5px); }

.actionmenularge .actionmenucontent.screenshot .sreenshot-container .image-=
screenshot { flex: 0 0 auto; }

.actionmenularge .actionmenucontent.screenshot .sreenshot-container .image-=
screenshot.b-hidden { display: none; }

.actionmenularge .actionmenucontent.screenshot .sreenshot-container .title =
{ position: absolute; left: 0px; right: 0px; bottom: 0px; }

.actionmenularge .actionmenucontent.screenshot .sreenshot-container::after =
{ content: ""; display: inline-block; width: calc(100% - 20px); height: 4px=
; filter: blur(14px); background: linear-gradient(251.21deg, rgba(29, 88, 1=
95, 0.4) 0.69%, rgba(0, 91, 255, 0.4) 0.7%, rgba(138, 92, 235, 0.4) 26.84%,=
 rgba(46, 155, 255, 0.4) 65.14%, rgba(46, 100, 206, 0.4) 77.54%); position:=
 absolute; bottom: -4px; left: 10px; z-index: -1; }

.actionmenularge .actionmenucontent.screenshot .actionlist .actionitem.shar=
eactionitem .sharemedia { margin-top: 20px; margin-bottom: 0px; }

@keyframes breathe {=20
  0% { background: rgb(204, 204, 204); }
  50% { background: rgba(204, 204, 204, 0.5); }
  100% { background: rgb(204, 204, 204); }
}

@media screen and (max-height: 690px) {
  .actionmenumobile.actionmenularge .actionmenucontent.screenshot .sreensho=
t-container { display: none; }
}

.actionmenudark.actionmenularge .actionmenucontent.screenshot .sreenshot-co=
ntainer { border: 1px solid rgb(72, 70, 68); }

.actionmenudark.actionmenularge .actionmenucontent.screenshot .sreenshot-co=
ntainer .image-container { background: rgb(0, 0, 0); }

.shareBar { background-color: rgb(136, 136, 136); margin: 0px -20px; paddin=
g: 0px 20px; }

:host { --share-spinner-fore: #050f2e; --share-spinner-back: #d1dbfa; }

.sh-dark { --share-spinner-fore: #fff; --share-spinner-back: rgba(255,255,2=
55,.4); }

.share-content-container .share-loading-spinner { position: absolute; inset=
: 0px; }

.share-content-container > :last-child { display: flex; justify-content: ce=
nter; align-items: center; gap: 10px; z-index: 1002; }

.content-disabled { pointer-events: none; opacity: 0.1; }

.display-none { display: none !important; }

.share-spinner { width: 28px; height: 28px; border-top-color: ; border-top-=
style: ; border-top-width: ; border-right-color: ; border-right-style: ; bo=
rder-right-width: ; border-bottom-style: ; border-bottom-width: ; border-le=
ft-color: ; border-left-style: ; border-left-width: ; border-image-source: =
; border-image-slice: ; border-image-width: ; border-image-outset: ; border=
-image-repeat: ; border-bottom-color: var(--share-spinner-fore); border-rad=
ius: 50%; display: inline-block; box-sizing: border-box; animation: 1s line=
ar 0s infinite normal none running share-spinner-rotation; }

@keyframes share-spinner-rotation {=20
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
