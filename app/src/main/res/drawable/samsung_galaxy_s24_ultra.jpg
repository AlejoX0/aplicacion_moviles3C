ght: 16px; width: 16px; background-color: transparent; border-radius: 2px; =
border: 1px solid rgb(145, 145, 145); }

#checkbox_region .cb_c .cb_w:hover { }

#checkbox_region .cb_c input:checked ~ .cb_w { background-color: rgb(0, 128=
, 157); border-radius: 2px; transform: rotate(0deg) scale(1); opacity: 1; b=
order: 0px; }

