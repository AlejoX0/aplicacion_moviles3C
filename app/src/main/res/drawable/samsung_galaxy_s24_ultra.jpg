Content-Location: cid:css-cacba1a8-70c1-4e3c-961d-850827fe7096@mhtml.blink

@charset "utf-8";

#mi_vwr { width: 100%; height: 100%; transform: translateZ(0px) scale(1, 1)=
; }

.richImage { display: inline-block; }

.richImage ul { list-style-type: none; padding: 0px; margin: 0px; }

.richImage .imgContainer { display: inline-block; position: relative; }

.richImage .hoverContainer { display: block; position: absolute; bottom: 0p=
x; width: 100%; box-sizing: border-box; }

.richImage .hoverContainer { display: none; }

.richImage:hover .hoverContainer, .richImage.focus .hoverContainer { displa=
y: block; }

.richImage img { vertical-align: top; }

.richImage img.ext { object-fit: contain; }

#actionbar.actionbar-h .noti_container.nt.hs::after { transform: translateY=
(-100%); top: 1px; bottom: auto; right: auto; }

.oneCol #actionbar.actionbar-h.io .vs_c, .twoCol #actionbar.actionbar-h.io =
.vs_c { position: relative; }

.oneCol #actionbar.actionbar-h.io .vs_c .noti_container.nt.hs, .twoCol #act=
ionbar.actionbar-h.io .vs_c .noti_container.nt.hs { width: max-content; top=
: 44px; left: auto; right: -200%; }

.oneCol #actionbar.actionbar-h.io li:nth-child(1) .noti_container.nt.hs::af=
ter, .twoCol #actionbar.actionbar-h.io li:nth-child(1) .noti_container.nt.h=
s::after { left: 45%; }

.oneCol #actionbar.actionbar-h.io li:nth-child(2) .noti_container.nt.hs::af=
ter, .twoCol #actionbar.actionbar-h.io li:nth-child(2) .noti_container.nt.h=
s::after { left: 63%; }

.oneCol #actionbar.actionbar-h.io li:nth-child(3) .noti_container.nt.hs::af=
ter, .twoCol #actionbar.actionbar-h.io li:nth-child(3) .noti_container.nt.h=
s::after { left: 79%; }

.oneCol #actionbar.actionbar-h.io li:nth-child(4) .noti_container.nt.hs::af=
ter, .twoCol #actionbar.actionbar-h.io li:nth-child(4) .noti_container.nt.h=
s::after { left: 79%; }

.twoCol #actionbar.actionbar-h .noti_container.nt.hs { bottom: auto; left: =
auto; top: 100%; }

.twoCol #actionbar.actionbar-h li:nth-child(1) .noti_container.nt.hs { righ=
t: 200px; }

.twoCol #actionbar.actionbar-h li:nth-child(1) .noti_container.nt.hs::after=
 { left: 50%; }

.twoCol #actionbar.actionbar-h li:nth-child(2) .noti_container.nt.hs { righ=
t: 78px; }

.twoCol #actionbar.actionbar-h li:nth-child(2) .noti_container.nt.hs::after=
 { left: 50%; }

.twoCol #actionbar.actionbar-h li:nth-child(3) .noti_container.nt.hs { righ=
t: 20px; }

.twoCol #actionbar.actionbar-h li:nth-child(3) .noti_container.nt.hs::after=
 { left: 60%; }

