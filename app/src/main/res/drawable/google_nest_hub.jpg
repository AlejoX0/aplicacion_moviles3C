r(--cardsbk); border-radius: 2px; font-size: 11px; text-transform: capitali=
ze; padding: 0px 8px; height: 18px; line-height: 18px; box-shadow: rgba(0, =
0, 0, 0.1) 0px 1px 2px 0px; }

