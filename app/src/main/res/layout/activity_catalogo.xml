<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/zenit_silver"
    tools:context=".CatalogoActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/catalogo_title"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textColor="@color/zenit_text_primary"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/catalogo_subtitle"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="@color/zenit_text_secondary" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupCategorias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTodos"
            style="@style/Widget.Material3.Chip.Assist"
            android:text="@string/catalogo_chip_todos"
            android:checked="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAudifonos"
            style="@style/Widget.Material3.Chip.Assist"
            android:text="@string/catalogo_chip_audio" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPerifericos"
            style="@style/Widget.Material3.Chip.Assist"
            android:text="@string/catalogo_chip_perifericos" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMousepads"
            style="@style/Widget.Material3.Chip.Assist"
            android:text="@string/catalogo_chip_mousepad" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMonitores"
            style="@style/Widget.Material3.Chip.Assist"
            android:text="@string/catalogo_chip_monitores" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAccesorios"
            style="@style/Widget.Material3.Chip.Assist"
            android:text="@string/catalogo_chip_accesorios" />
    </com.google.android.material.chip.ChipGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCatalogo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonVolverMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/action_volver_menu" />
</LinearLayout>
