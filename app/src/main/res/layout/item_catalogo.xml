<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageViewItemHero"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:contentDescription="@string/catalogo_image_content_description"
            android:scaleType="centerCrop"
            android:src="@drawable/gallery_placeholder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textViewItemCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/zenit_blue" />

            <TextView
                android:id="@+id/textViewItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/zenit_text_primary"
                android:textStyle="bold"
                tools:text="MacBook Air M3 13'' (2024)" />

            <TextView
                android:id="@+id/textViewItemDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/zenit_text_secondary"
                tools:text="Chip Apple M3, 8GB RAM y SSD de 256GB con autonomía de hasta 18h." />

            <TextView
                android:id="@+id/textViewItemHighlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/zenit_blue"
                android:textStyle="bold"
                tools:text="Ligera, silenciosa y lista para edición en movimiento." />

            <TextView
                android:id="@+id/textViewItemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_gradient_primary"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="8dp"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                tools:text="$6.899.000 COP" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
